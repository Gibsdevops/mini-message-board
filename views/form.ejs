<!DOCTYPE html>
<html>
<head>
  <title><%= title %></title>
</head>
<body>
  <h1><%= title %></h1>
  <form action="/new" method="POST">
    <label for="messageUser">Your Name:</label>
    <input type="text" id="messageUser" name="messageUser" required>
    <br><br>

    <label for="messageText">Message:</label>
    <input type="text" id="messageText" name="messageText" required>
    <br><br>

    <button type="submit">Submit</button>
  </form>
  <a href="/">Back to Messages</a>
</body>
</html>
